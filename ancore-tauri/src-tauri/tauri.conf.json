{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../ui",
    "distDir": "../ui",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "AnCore Studio",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "dialog": { "all": true },
      "fs": { "all": true, "scope": ["**"] }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "Copyright © Galala University — Apache-2.0 License",
      "deb": { "depends": [] },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "org.ancore.scientific.studio",
      "longDescription": "AnCore Scientific Studio: 6-Stage Chemoinformatics, Molecular Docking, Interaction Fingerprinting, and 300 K MD Triage Suite",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "AnCore Scientific Studio",
      "targets": ["app", "dmg"]
    },
    "security": { "csp": null },
    "updater": { "active": false },
    "windows": [
      {
        "fullscreen": false,
        "height": 940,
        "resizable": true,
        "title": "AnCore Scientific Studio — Structure-Based Chemoinformatics & MD Triage Suite",
        "width": 1540,
        "minWidth": 1180,
        "minHeight": 760
      }
    ]
  }
}
